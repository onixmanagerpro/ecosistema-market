# Configuración de Firebase (Web SDK). Estos valores se obtienen en:
# Firebase Console > Configuración del proyecto > Tus apps > SDK setup and configuration.
#
# Son opcionales: si no se definen, el proyecto usa por defecto los valores
# de firebase-applet-config.json. Se recomienda definirlas en Vercel
# (Project Settings > Environment Variables) para no depender del JSON versionado.
VITE_FIREBASE_API_KEY="MY_FIREBASE_API_KEY"
VITE_FIREBASE_AUTH_DOMAIN="my-project.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="my-project-id"
VITE_FIREBASE_STORAGE_BUCKET="my-project.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="1234567890"
VITE_FIREBASE_APP_ID="1:1234567890:web:abcdef"
# Solo necesario si usas una base de datos de Firestore distinta a "(default)"
VITE_FIREBASE_FIRESTORE_DATABASE_ID=""
