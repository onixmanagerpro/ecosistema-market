rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read: if true;
      allow write: if request.auth != null || true;
    }
    match /projects/{projectId} {
      allow read: if true;
      allow write: if request.auth != null || true;
    }
    match /tasks/{taskId} {
      allow read: if true;
      allow write: if request.auth != null || true;
    }
    match /messages/{messageId} {
      allow read: if true;
      allow write: if request.auth != null || true;
    }
    match /notifications/{notificationId} {
      allow read: if true;
      allow write: if request.auth != null || true;
    }
  }
}
